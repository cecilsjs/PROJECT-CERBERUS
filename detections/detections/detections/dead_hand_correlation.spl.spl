index=cerberus

| transaction user maxspan=15m

| eval login_hour=tonumber(strftime(_time, "%H"))

| eval ghost_risk=if(failed_logins >= 5, 20, 0)
| eval ghost_risk=ghost_risk + if(mvfind(extracted_host, "HR-WS-01") >= 0, 25, 0)
| eval ghost_risk=ghost_risk + if(login_hour < 8, 20, 0)

| eval endpoint_risk=if(mvfind(process, "cmd.exe") >= 0, 10, 0)
| eval endpoint_risk=endpoint_risk + if(mvfind(process, "powershell.exe") >= 0, 20, 0)
| eval endpoint_risk=endpoint_risk + if(
    mvfind(process, "powershell.exe") >= 0
    AND mvfind(parent_process, "excel.exe") >= 0,
    30,
    0
)

| eval network_risk=if(mvfind(destination, "FIN-SRV-01") >= 0, 10, 0)
| eval network_risk=network_risk + if(mvfind(destination, "DC-01") >= 0, 20, 0)
| eval network_risk=network_risk + if(
    mvfind(destination, "DC-01") >= 0
    AND mvfind(protocol, "SMB") >= 0,
    25,
    0
)

| eval weighted_ghost=ghost_risk * 0.35
| eval weighted_endpoint=endpoint_risk * 0.35
| eval weighted_network=network_risk * 0.30

| eval correlation_bonus=if(
    ghost_risk >= 40
    AND endpoint_risk >= 40
    AND network_risk >= 40,
    20,
    0
)

| eval cerberus_score=weighted_ghost + weighted_endpoint + weighted_network + correlation_bonus

| eval cerberus_status=case(
    cerberus_score >= 75, "CRITICAL",
    cerberus_score >= 60, "HIGH",
    cerberus_score >= 40, "MONITOR",
    true(), "LOW"
)

| eval ghost_mitre=if(ghost_risk >= 40, "T1110.001", null())
| eval endpoint_mitre=if(endpoint_risk >= 40, "T1059.001", null())
| eval network_mitre=if(network_risk >= 40, "T1021.002", null())

| eval attack_techniques=mvappend(
    ghost_mitre,
    endpoint_mitre,
    network_mitre
)
| eval attack_techniques=mvjoin(attack_techniques, " -> ")

| eval ghost_tactic=if(ghost_risk >= 40, "Credential Access", null())
| eval endpoint_tactic=if(endpoint_risk >= 40, "Execution", null())
| eval network_tactic=if(network_risk >= 40, "Lateral Movement", null())

| eval attack_tactics=mvappend(
    ghost_tactic,
    endpoint_tactic,
    network_tactic
)
| eval attack_tactics=mvjoin(attack_tactics, " -> ")

| eval ghost_chain=if(ghost_risk >= 40, "Password Guessing", null())
| eval endpoint_chain=if(endpoint_risk >= 40, "PowerShell", null())
| eval network_chain=if(network_risk >= 40, "SMB/Windows Admin Shares", null())

| eval attack_chain=mvappend(
    ghost_chain,
    endpoint_chain,
    network_chain
)
| eval attack_chain=mvjoin(attack_chain, " -> ")

| table _time user duration eventcount ghost_risk endpoint_risk network_risk correlation_bonus cerberus_score cerberus_status attack_tactics attack_techniques attack_chain
