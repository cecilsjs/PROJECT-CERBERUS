index=cerberus source="*endpoint_events.csv"
| eval endpoint_risk=if(process="cmd.exe", 10, 0)
| eval endpoint_risk=endpoint_risk + if(process="powershell.exe", 20, 0)
| eval endpoint_risk=endpoint_risk + if(
    process="powershell.exe"
    AND parent_process="excel.exe",
    30,
    0
)
| eval endpoint_status=case(
    endpoint_risk >= 75, "CRITICAL",
    endpoint_risk >= 60, "HIGH",
    endpoint_risk >= 40, "MONITOR",
    true(), "LOW"
)
| where endpoint_risk >= 40
| eval mitre_tactic="Execution",
       mitre_technique="PowerShell",
       mitre_technique_id="T1059.001",
       mapping_confidence="HIGH"
| table timestamp user host process parent_process endpoint_risk endpoint_status mitre_tactic mitre_technique mitre_technique_id mapping_confidence
